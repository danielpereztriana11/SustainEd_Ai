GCP_PROJECT_ID=your-project-id
GCP_REGION=europe-west2
GCP_BUCKET_NAME=your-bucket-name

# Génération du dataset : modèle Gemini appelé via Vertex AI (scripts/build_dataset.py)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LOCATION=global

# Endpoint Vertex AI du modèle déployé
GCP_PROJECT_NUMBER=your-project-number
GCP_ENDPOINT_ID=your-endpoint-id
INPUT_DATA_FILE=scripts/sample_request.json

# Langfuse (clés API du projet, Settings > API Keys)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# Optionnel : uniquement si les Application Default Credentials ne sont pas détectées automatiquement
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json
